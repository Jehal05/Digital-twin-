# Copy to deploy/.env (never commit it) and fill in.
POSTGRES_PASSWORD=change-me
# 32+ random characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
HT_SECRET_KEY=
# The address users open in the browser (used for CORS)
PUBLIC_ORIGIN=http://localhost:8080
# Optional: enables free-text answers in the AI explainer (leave empty to keep the built-in explanations only)
HT_ANTHROPIC_API_KEY=
